# Web app configuration (Next.js + Auth.js). Copy to web/.env.local and fill in.

# ---- Required -----------------------------------------------------------
# Encrypts Auth.js session cookies. Generate with: npx auth secret
AUTH_SECRET=

# Where the FastAPI backend listens.
FASTAPI_URL=http://127.0.0.1:8000

# Signs the short-lived service tokens sent to FastAPI.
# Must be exactly the same value as jwt_secret in the backend's .env.
FASTAPI_JWT_SECRET=

# Postgres that holds the Auth.js tables (users, accounts, sessions).
# Use the same database as the backend's database_url, but as a plain
# postgres:// URL (no +psycopg); the backend reads users' Google tokens from it.
AUTH_PG_URL=postgresql://agentic:agentic@localhost:5432/hangul_harness

# ---- Sign-in providers (configure at least one) -------------------------
# Google: create an OAuth client at https://console.cloud.google.com/apis/credentials
# with redirect URI http://localhost:3000/api/auth/callback/google.
# Required for /admin, and reused by the backend for the Google Workspace connector.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email magic links via Resend (https://resend.com).
AUTH_RESEND_KEY=
# e.g. Hangul <login@yourdomain.com>
AUTH_EMAIL_FROM=

# ---- Deployment ---------------------------------------------------------
# Needed behind a proxy or on a non-Vercel host.
# AUTH_URL=https://hangul.example.com
# AUTH_TRUST_HOST=true
