# Backend configuration (FastAPI, harness/config.py). Copy to .env and fill in.
# Names are case-insensitive. Only the REQUIRED block is needed for a first run;
# everything else has a working default or switches a feature off when empty.

# ---- Required -----------------------------------------------------------
# From https://platform.openai.com/api-keys (sk-...)
openai_api_key =
# Postgres with the pgvector extension. `docker compose up -d` starts one
# matching this URL; then run `alembic upgrade head`.
database_url = postgresql+psycopg://agentic:agentic@localhost:5432/hangul_harness
redis_url = redis://localhost:6379/0

# Signs the service tokens the web app mints; must equal FASTAPI_JWT_SECRET in web/.env.local.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty falls back to an insecure dev default, which environment=prod refuses.
jwt_secret =

# ---- General ------------------------------------------------------------
app_name = "hangul-harness"
log_level = "INFO"
environment = "dev"                     # "prod" refuses to start without a real jwt_secret
model = gpt-5.5                         # default model; must be a key of providers.registry.MODELS
default_effort = medium                 # reasoning effort when a request sets none

# ---- Token vault (harness/vault) ----------------------------------------
# Encrypts third-party credentials. Generate your own key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty = vault disabled (web_search and vault_* tools report VAULT_UNAVAILABLE).
# Never reuse a key from an example or another deployment.
vault_master_key =
vault_grant_ttl_s = 300
vault_public_url = http://127.0.0.1:8000   # how MCP subprocesses reach /vault/proxy

# Web search (optional). Imported into the vault at startup as an operator
# credential; needs vault_master_key.
tavily_api_key =

# ---- Admin console (/admin) ---------------------------------------------
# Only these Google-verified emails may use it. Comma-separated.
# There is no default: leave empty and /admin is disabled.
# e.g. you@example.com,ops@example.com
admin_emails =
admin_max_auth_age_s = 43200            # the Google sign-in must be younger than this
# optional CIDRs, e.g. 10.0.0.0/8,203.0.113.4/32
admin_ip_allowlist =

# ---- Prompt-injection defence (harness/security) ------------------------
# The pattern detector is always on; the model-based screen of tool results
# is opt-in (one small model call per screened result).
security_llm_screen = false
security_screen_model = gpt-4.1-mini
security_offender_limit = 5             # flagged user messages per window before 429
security_offender_window_s = 600

# ---- Google Workspace connector (optional) ------------------------------
# The backend refreshes users' Workspace access tokens with the same OAuth
# client the web app signs in with (AUTH_GOOGLE_ID/SECRET in web/.env.local).
auth_google_id =
auth_google_secret =

# ---- Scheduled tasks ----------------------------------------------------
# Run in-process every minute. With more than one API replica, set false on
# all but one, or each replica runs every due task.
scheduler_enabled = true
