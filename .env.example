app_name = "hangul-harness"
log_level = "INFO"
environment = "dev"

# Token vault (harness/vault). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Unset = vault disabled (web_search and vault_* tools report VAULT_UNAVAILABLE).
vault_master_key =JiUTssNlpbuFGV7Oo1Gu6L8FMTylwzwor_JSQLb3nt8=
vault_grant_ttl_s = 300
vault_public_url = http://127.0.0.1:8000

# Admin console (/admin). Only these Google-verified emails may use it; the
# default is hard-coded in harness/config.py. Comma-separated to allow more.
admin_emails = aasimmallikk@gmail.com
admin_max_auth_age_s = 43200            # the Google sign-in must be younger than this
admin_ip_allowlist =                    # optional CIDRs, e.g. 10.0.0.0/8,203.0.113.4/32

# Prompt-injection defence (harness/security). The pattern detector is always
# on; the model-based screen of tool results is opt-in (one small model call
# per screened result).
security_llm_screen = false
security_screen_model = gpt-4.1-mini
security_offender_limit = 5             # flagged user messages per window before 429
security_offender_window_s = 600

# Google Workspace bundle: the backend refreshes users' Workspace access tokens
# with the same OAuth client the web app signs in with (web/.env AUTH_GOOGLE_ID).
auth_google_id =
auth_google_secret =
# Scheduled tasks run in-process every minute (set false on replicas that
# should not run them; today each replica would run due tasks).
scheduler_enabled = true

# Billing via Dodo Payments (harness/billing). Leave the API key empty to keep
# billing off (no plan checks, every model open).
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_PLUS=
DODO_PRODUCT_PRO=
DODO_PRODUCT_TOPUP=
DODO_TEST_MODE=true
BILLING_RETURN_URL=http://localhost:3000/billing
# Allowances / top-up credit are dollars of MODEL cost, not the price charged.
BILLING_ALLOWANCE_FREE=0.50
BILLING_ALLOWANCE_PLUS=8.00
BILLING_ALLOWANCE_PRO=40.00
BILLING_TOPUP_CREDIT_USD=5.00
# Monthly cap on what ALL free users together may spend (model cost). Leave
# unset for no cap; set it at launch so free sign-ups can't drain the OpenAI
# balance your paying users need.
BILLING_FREE_POOL_USD=10

# Everyday assistant. Reminder emails go through Resend -- the same key the web
# app uses for sign-in links (AUTH_RESEND_KEY / AUTH_EMAIL_FROM also work).
# Unset = reminders show in the app only.
RESEND_API_KEY=
EMAIL_FROM=Hangul <reminders@your-domain.com>
APP_URL=http://localhost:3000
# Reads uploaded photos/screenshots; must be a model in providers/registry.py.
VISION_MODEL=gpt-5-mini

# Voice (harness/media/voice.py). Costs are charged to the user's allowance at
# these approximate rates -- check OpenAI's pricing page.
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
STT_USD_PER_MINUTE=0.003
TTS_USD_PER_1K_CHARS=0.015

# Phase 4. Image generation (Pro): needs a verified OpenAI organisation for
# gpt-image-1. Maps use OpenStreetMap, which asks for a contact address.
IMAGE_MODEL=gpt-image-1
IMAGE_DEFAULT_QUALITY=medium
MAPS_CONTACT_EMAIL=

# "Auto" model choice: the model for quick / everyday / deep messages (each
# falls back down to what the user's plan includes).
AUTO_FAST_MODEL=gpt-5.6-luna
AUTO_BALANCED_MODEL=gpt-5.6-terra
AUTO_BEST_MODEL=gpt-5.6-sol
