# Production settings for docker-compose.prod.yml. Copy to .env.production on
# the server, fill it in, and never commit it. Both containers read this file.
# Generate secrets with:  openssl rand -base64 48

# ---- the site ----
HANGUL_DOMAIN=app.example.com            # its DNS A record points at this server
APP_URL=https://app.example.com          # links in emails and WhatsApp
ENVIRONMENT=prod                         # the API refuses to start with a weak JWT_SECRET
# HANGUL_IMAGE_TAG=latest                # or a commit sha, to pin a version

# ---- database + cache (hosted, or `--profile db` on this server) ----
DATABASE_URL=postgresql+psycopg://user:pass@host/db?sslmode=require
# Seconds to wait for a connection (Neon waking from scale-to-zero took ~8 s). Default 10.
# DB_CONNECT_TIMEOUT=10
REDIS_URL=redis://default:pass@host:6379/0
# with --profile db instead:
#   POSTGRES_PASSWORD=<random>
#   DATABASE_URL=postgresql+psycopg://hangul:<POSTGRES_PASSWORD>@postgres:5432/hangul
#   REDIS_URL=redis://redis:6379/0
# the web app's sign-in tables (same database, plain postgres:// URL)
AUTH_PG_URL=postgresql://user:pass@host/db?sslmode=require

# ---- secrets shared by web and API ----
JWT_SECRET=<openssl rand -base64 48>                 # API: verifies the web app's service tokens
FASTAPI_JWT_SECRET=<the same value as JWT_SECRET>    # web: signs them
VAULT_MASTER_KEY=<python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())">

# ---- sign-in (Auth.js) ----
AUTH_SECRET=<openssl rand -base64 48>
AUTH_TRUST_HOST=true                     # behind Caddy
AUTH_URL=https://app.example.com
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=Hangul <hello@example.com>

# Notifications on phones and computers (Web Push, harness/push.py). Free on
# every plan. Off until both keys are set; make a pair once with
#   python -m harness.push keys
# and keep it: a new pair makes every device turn notifications on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com   # default: mailto:<EMAIL_FROM>

# ---- AI and tools ----
OPENAI_API_KEY=
TAVILY_API_KEY=
MAPS_CONTACT_EMAIL=hello@example.com     # OpenStreetMap asks for a contact
ADMIN_EMAILS=you@example.com             # who can open /admin (Google sign-in)
# Gmail and Drive need Google's paid yearly security assessment (CASA) past 100 users.
# Until then offer them only to your testers (comma-separated; admins always included).
# "*" = everyone: set it only once the assessment is done.
GOOGLE_RESTRICTED_EMAILS=you@example.com

# ---- billing (Dodo Payments); unset DODO_API_KEY = billing off ----
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_TEST_MODE=true                      # false when you go live
DODO_PRODUCT_PLUS=
DODO_PRODUCT_PRO=
DODO_PRODUCT_TOPUP=
# one more brand, paid once ($5; the _IN product in INR, ₹399)
DODO_PRODUCT_BRAND_SLOT=
DODO_PRODUCT_BRAND_SLOT_IN=
BILLING_RETURN_URL=https://app.example.com/billing
# REQUIRED before launch: the most all free users together may cost per month (USD)
BILLING_FREE_POOL_USD=50

# ---- WhatsApp (optional; see the WhatsApp section of .env.example) ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
